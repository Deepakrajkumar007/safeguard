# Copy this file to .env.local and fill in your keys. Never commit .env.local.
# Optional: AI explanations and screenshot reading in the web app (Google Gemini).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the Gemini model (default: gemini-3.6-flash)
GEMINI_MODEL=
# Optional: Google Safe Browsing (https://developers.google.com/safe-browsing)
GOOGLE_SAFE_BROWSING_KEY=

# Shared key the iPhone app (and its Shortcuts action) sends in the x-linkguard-key header. Generate with: openssl rand -hex 24
LINKGUARD_APP_KEY=

# Gmail scanning (optional). Google Cloud Console > OAuth client (Web application).
# Redirect URI: https://<your-domain>/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts the 1-hour Gmail session token. Generate with: openssl rand -hex 32
SESSION_SECRET=
