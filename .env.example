# Copy this file to .env.local and fill in your keys. Never commit .env.local.
# Required for AI explanations, screenshot reading, and call analysis (Google Gemini).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the Gemini model (default: gemini-3.6-flash)
GEMINI_MODEL=
# Optional: Google Safe Browsing (https://developers.google.com/safe-browsing)
GOOGLE_SAFE_BROWSING_KEY=
# Optional: URLhaus by abuse.ch (free Auth-Key from https://auth.abuse.ch/)
URLHAUS_AUTH_KEY=
