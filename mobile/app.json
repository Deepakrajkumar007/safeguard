{
  "expo": {
    "name": "LinkGuard",
    "slug": "linkguard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.deepakrajkumar.linkguard",
      "appleTeamId": "ASCQD39794"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser",
      "./plugins/withoutPushEntitlement.js",
      "expo-app-intents"
    ],
    "scheme": "linkguard",
    "experiments": {
      "inlineModules": {
        "watchedDirectories": [
          "app-intents"
        ]
      }
    }
  }
}
